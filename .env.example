# CollegeConnect - Configuration Environment Variables
# Copy this file to .env and configure your database connection credentials and AI API key.
# Do NOT commit actual passwords or production credentials to version control.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=collegeconnect
MYSQL_USER=root
MYSQL_PASSWORD=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
